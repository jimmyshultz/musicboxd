# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Resonare' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Add this line for Google Sign-In
  pod 'GoogleSignIn'
  
  # Firebase Crashlytics and Messaging with specific modular headers for dependencies
  pod 'Firebase/Crashlytics'
  pod 'Firebase/Messaging'
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'FirebaseMessaging', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  
  # Note: react-native-worklets is auto-linked by React Native with the New Architecture
  
  # Note: Apple Sign-In (RNAppleAuthentication) is auto-linked by React Native 0.60+

  post_install do |installer|
    # https://github.com/facebook/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Restore the Crashlytics dSYM upload build phase.
    #
    # @react-native-firebase/crashlytics v26 dropped the `ios.scriptPhases`
    # block from its react-native.config.js during the TurboModules migration,
    # so autolinking no longer injects the "[RNFB] Crashlytics Configuration"
    # phase and `pod install` strips it from the project. The package still
    # ships ios_config.sh unchanged, and the sibling @react-native-firebase/app
    # kept its own scriptPhases block — so this looks like an upstream
    # oversight rather than an intentional removal (the v26 changelog does not
    # mention it).
    #
    # Without this phase, release builds never run FirebaseCrashlytics/run,
    # dSYMs are not uploaded, and production crash reports arrive
    # unsymbolicated. Re-added here so it survives `pod install`.
    #
    # REMOVE THIS once upstream restores the scriptPhases block, otherwise the
    # phase would be added twice (the guard below makes that harmless).
    crashlytics_phase_name = '[RNFB] Crashlytics Configuration'
    crashlytics_script = File.join(
      '${PODS_ROOT}', '..', '..', 'node_modules',
      '@react-native-firebase', 'crashlytics', 'ios_config.sh'
    )
    installer.aggregate_targets.each do |aggregate_target|
      user_project = aggregate_target.user_project
      next if user_project.nil?
      changed = false
      user_project.targets.each do |target|
        next unless target.name == 'Resonare'
        next if target.shell_script_build_phases.any? { |p| p.name == crashlytics_phase_name }
        phase = target.new_shell_script_build_phase(crashlytics_phase_name)
        phase.shell_path = '/bin/sh'
        phase.shell_script = %("#{crashlytics_script}"\n)
        phase.input_paths = [
          '${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}/Contents/Resources/DWARF/${TARGET_NAME}',
          '$(BUILT_PRODUCTS_DIR)/$(INFOPLIST_PATH)',
        ]
        phase.run_only_for_deployment_postprocessing = '0'
        changed = true
        Pod::UI.puts "Re-added #{crashlytics_phase_name} build phase (RNFB v26 workaround)".yellow
      end
      user_project.save if changed
    end

    # Configure build configurations for environment switching
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Map new configurations to base configurations
        case config.name
        when 'Debug-Development', 'Debug-Staging'
          config.build_settings = config.build_settings.merge(installer.pods_project.build_configurations.find { |c| c.name == 'Debug' }.build_settings)
        when 'Release-Development', 'Release-Staging'
          config.build_settings = config.build_settings.merge(installer.pods_project.build_configurations.find { |c| c.name == 'Release' }.build_settings)
        end
      end
    end

    # Ensure Firebase Swift modules are properly configured
    installer.pods_project.targets.each do |target|
      if ['FirebaseCoreInternal', 'FirebaseCrashlytics', 'FirebaseSessions', 'FirebaseMessaging', 'GoogleUtilities', 'FirebaseCore', 'FirebaseInstallations', 'GoogleDataTransport', 'nanopb', 'FirebaseCoreExtension'].include?(target.name)
        target.build_configurations.each do |config|
          config.build_settings['DEFINES_MODULE'] = 'YES'
          config.build_settings['SWIFT_VERSION'] = '5.0'
        end
      end
    end
  end
end